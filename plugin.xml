<?xml version="1.0" encoding="UTF-8"?>
<glpi_plugin>
    <name>flowBPMN</name>
    <display_name>BPMN Flow</display_name>
    <version>1.0.0</version>
    <author>Diego Jucá - KactuX</author>
    <license>GPLv3+</license>
    <homepage>https://github.com/diegojucah/pluginBPMN</homepage>
    <description>
        <short>
            <en>BPMN Editor for GLPI 11</en>
            <pt_BR>Editor BPMN para GLPI 11</pt_BR>
        </short>
        <long>
            <en>BPMN Editor and Viewer for GLPI with support for tickets, changes, and problems. Create, edit, version and export BPMN diagrams.</en>
            <pt_BR>Editor e Visualizador BPMN para GLPI com suporte para chamados, mudanças e problemas. Crie, edite, versione e exporte diagramas BPMN.</pt_BR>
        </long>
    </description>
    <min_glpi_version>11.0.0</min_glpi_version>
    <max_glpi_version>11.99.99</max_glpi_version>
    
    <requirements>
        <requirement type="php" version="8.0"/>
        <requirement type="glpi" version="11.0.0" max_version="11.99.99"/>
    </requirements>
    
    <tables>
        <table name="glpi_plugin_flowbpmn_flows" version="1.0.0"/>
        <table name="glpi_plugin_flowbpmn_versions" version="1.0.0"/>
        <table name="glpi_plugin_flowbpmn_profiles" version="1.0.0"/>
        <table name="glpi_plugin_flowbpmn_configs" version="1.0.0"/>
    </tables>
</glpi_plugin>
